generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String          @id @default(cuid())
  name             String
  createdAt        DateTime        @default(now())
  slug             String?         @unique
  publicBookingEnabled Boolean     @default(false)
  updatedAt        DateTime        @updatedAt
  stripeCustomerId String?

  // Stripe Connect / Host Payouts V1
  stripeConnectAccountId        String?              @unique
  stripeConnectStatus           StripeConnectStatus  @default(NOT_CONNECTED)
  stripeConnectChargesEnabled   Boolean              @default(false)
  stripeConnectPayoutsEnabled   Boolean              @default(false)
  stripeConnectDetailsSubmitted Boolean              @default(false)
  stripeConnectRequirements     Json?
  stripeConnectDisabledReason   String?
  stripeConnectLastSyncedAt     DateTime?

  dashboardUsers   DashboardUser[]
  deviceHealths    DeviceHealth[]
  lockGroups       LockGroup[]
  pendingSignups   PendingSignup[]
  people           Person[]
  pmsConnections   PmsConnection[]
  properties       Property[]
  staffMembers     StaffMember[]
  subscriptions    Subscription?
  ttlockAuth       TTLockAuth?
}

model DashboardUser {
  id                  String               @id @default(cuid())
  organizationId      String
  email               String               @unique
  passwordHash        String
  fullName            String?
  role                DashboardUserRole    @default(ORG_ADMIN)
  isActive            Boolean              @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tokenVersion        Int                  @default(0)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  passwordResetSmsCodes PasswordResetSmsCode[]

  @@index([organizationId, isActive])
  @@index([organizationId, role])
}

model PasswordResetToken {
  id        String        @id @default(cuid())
  userId    String
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetSmsCode {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
  @@index([expiresAt])
}

model Property {
  id                         String                      @id @default(cuid())
  organizationId             String
  name                       String
  slug                       String?
  isPublicBookable           Boolean                     @default(false)
  distributionEnabled        Boolean                     @default(false)
  distributionStatus         String                      @default("DISABLED")
  distributionEnabledAt      DateTime?
  distributionLastSyncedAt   DateTime?
  distributionLastError      String?
  publicTitle                String?
  publicDescription          String?
  publicPhotos               Json?
  baseNightlyRate            Decimal?                    @db.Decimal(10,2)
  minimumNightlyRate         Decimal?                    @db.Decimal(10,2)
  maximumNightlyRate         Decimal?                    @db.Decimal(10,2)
  dynamicPricingEnabled      Boolean                     @default(false)
  weekendMarkupPercent       Decimal?                    @db.Decimal(5,2)
  leadTimePricingEnabled     Boolean                     @default(false)
  leadTimeLastMinuteDays     Int                         @default(3)
  leadTimeLastMinutePercent  Decimal?                    @db.Decimal(5,2)
  occupancyPricingEnabled    Boolean                     @default(false)
  occupancyLookaheadDays     Int                         @default(30)
  occupancyLowThresholdPercent   Decimal?                @db.Decimal(5,2)
  occupancyLowAdjustmentPercent  Decimal?                @db.Decimal(5,2)
  occupancyHighThresholdPercent  Decimal?                @db.Decimal(5,2)
  occupancyHighAdjustmentPercent Decimal?                @db.Decimal(5,2)
  seasonalPricingEnabled     Boolean                     @default(false)
  holidayPricingEnabled      Boolean                     @default(false)
  eventPricingEnabled        Boolean                     @default(false)
  autonomousPricingEnabled   Boolean                     @default(false)
  cleaningFee                Decimal?                    @db.Decimal(10,2)
  maxGuests                  Int?
  minimumNights              Int                         @default(1)
  maximumNights              Int?
  address1                   String?
  city                       String?
  region                     String?
  country                    String?
  timezone                   String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  cleaningDurationMinutes    Int                         @default(180)
  cleaningStartOffsetMinutes Int                         @default(30)
  status                     String                      @default("ACTIVE")
  latitude                   Decimal?                    @db.Decimal(10, 7)
  longitude                  Decimal?                    @db.Decimal(10, 7)
  smartAutomationEnabled     Boolean                     @default(false)
  checkInTime                String?                     @db.VarChar(5)
  checkOutTime               String?                     @db.VarChar(5)
  automationExecutionLogs    AutomationExecutionLog[]
  automationRules            AutomationRule[]
  deviceHealths              DeviceHealth[]
  locks                      Lock[]
  organization               Organization                @relation(fields: [organizationId], references: [id])
  guestAccessMode            GuestAccessMode             @default(PASSCODE_ONLY)
  cleaningNfcEnabled         Boolean                     @default(false)
  automationDevices          PropertyAutomationDevice[]
  automationSettings         PropertyAutomationSettings?
  propertyDevices            PropertyDevice[]
  propertyStaff              PropertyStaff[]
  amenities                  PropertyAmenity[]
  taxes                      PropertyTax[]
  nightlyRates               PropertyNightlyRate[]
  seasons                    PropertySeason[]
  holidayPricings            PropertyHolidayPricing[]
  reservations               Reservation[]
  blockedDates               PropertyBlockedDate[]
  cancellationPolicies       PropertyCancellationPolicy[]
  guestAgreements            PropertyGuestAgreement[]


  @@index([organizationId])
  @@index([organizationId, status])
  @@unique([organizationId, slug])
}

model PropertyNightlyRate {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  date       DateTime
  rate       Decimal  @db.Decimal(10, 2)
  reason     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, date])
  @@index([propertyId, date])
}

model PropertySeason {
  id                String   @id @default(cuid())
  propertyId        String
  name              String
  type              SeasonType @default(SHOULDER)
  startMonth        Int
  startDay          Int
  endMonth          Int
  endDay            Int
  adjustmentPercent Decimal  @db.Decimal(5,2)
  isActive          Boolean  @default(true)
  source            String   @default("CUSTOM")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, isActive])
  @@index([propertyId, source])
  @@index([type])

}

model MarketSeasonTemplate {
  id                String   @id @default(cuid())
  country           String
  region            String?
  name              String
  type              SeasonType @default(SHOULDER)
  startMonth        Int
  startDay          Int
  endMonth          Int
  endDay            Int
  adjustmentPercent Decimal  @db.Decimal(5,2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([country])
  @@index([country, isActive])
  @@index([country, region])
  @@index([type])
}

model PropertyHolidayPricing {
  id                String   @id @default(cuid())
  propertyId        String
  name              String
  startMonth        Int
  startDay          Int
  endMonth          Int
  endDay            Int
  adjustmentPercent Decimal  @db.Decimal(5,2)
  isActive          Boolean  @default(true)
  source            String   @default("PIN_GO_DEFAULT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, isActive])
  @@index([propertyId, source])
}

model Lock {
  id             String          @id @default(cuid())
  ttlockLockId   Int             @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isActive       Boolean         @default(true)
  locationLabel  String?
  propertyId     String
  ttlockLockName String?
  displayName    String?
  sGrants        AccessGrant[]
  deviceHealth   DeviceHealth?
  property       Property        @relation(fields: [propertyId], references: [id])
  groups         LockGroupLock[]

  @@index([propertyId, isActive])
}

model Person {
  id               String              @id @default(cuid())
  organizationId   String
  role             PersonRole
  fullName         String
  email            String?
  phone            String?
  stripeCustomerId String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  accessGrants     AccessGrant[]
  assignments      ManagerAssignment[]
  organization     Organization        @relation(fields: [organizationId], references: [id])
  subscriptions    Subscription[]

  @@index([organizationId, role])
}

model PendingSignup {
  id                      String              @id @default(cuid())
  email                   String
  passwordHash            String
  fullName                String?
  organizationName        String
  phone                   String?
  requestedLocks          Int                 @default(1)
  stripeCheckoutSessionId String?             @unique
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePriceId           String?
  status                  PendingSignupStatus @default(PENDING)
  organizationId          String?
  completedAt             DateTime?
  expiresAt               DateTime?
  metadata                Json?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  organization            Organization?       @relation(fields: [organizationId], references: [id])

  @@index([email])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Subscription {
  id                            String             @id @default(cuid())
  personId                      String?
  stripeSubscriptionId          String?            @unique
  status                        SubscriptionStatus
  currentPeriodStart            DateTime?
  currentPeriodEnd              DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  graceUntil                    DateTime?
  organizationId                String             @unique
  stripeCustomerId              String?
  entitledLocks                 Int                @default(0)
  stripeSubscriptionItemId      String?
  entitledSmartProperties       Int                @default(0)
  stripeSmartSubscriptionItemId String?
  organization                  Organization       @relation(fields: [organizationId], references: [id])
  person                        Person?            @relation(fields: [personId], references: [id])

  @@index([personId, status])
  @@index([organizationId, status])
}

model Reservation {
  id                      String                   @id @default(cuid())
  reservationNumber       String?                  @unique
  propertyId              String
  guestName               String
  guestEmail              String?
  guestPhone              String?
  preferredLanguage       String                   @default("en")
  roomName                String?
  checkIn                 DateTime
  checkOut                DateTime
  paymentState            PaymentState             @default(NONE)
  totalAmount             Decimal?                 @db.Decimal(10,2)
  currency                String?                  @default("usd")
  stripeCheckoutSessionId String?                  @unique
  stripePaymentIntentId   String?
  // Stripe Connect / Host Payouts V1
  stripeConnectedAccountId String?
  stripeChargeId           String?
  stripeTransferId         String?
  stripeApplicationFeeId   String?
  basePlatformFeeAmount    Decimal?                @db.Decimal(10,2)
  platformFeeAmount        Decimal?                @db.Decimal(10,2)
  hostPayoutAmount         Decimal?                @db.Decimal(10,2)
  hostPayoutStatus         HostPayoutStatus        @default(NOT_APPLICABLE)
  hostPayoutFailureReason  String?
  hostPayoutLastSyncedAt   DateTime?

  // Direct Booking Cancellation Policy Engine V1
  cancellationPolicyId       String?
  cancellationPolicySnapshot Json?
  cancellationRequestedAt    DateTime?
  cancellationRequestedBy    CancellationActor?
  cancellationEvaluatedAt    DateTime?
  cancellationEvaluation     Json?
  cancelledAt                DateTime?
  cancelledBy                CancellationActor?
  cancelledByUserId          String?
  cancellationReason         String?
  cancellationRefundAmount   Decimal?               @db.Decimal(10,2)
  cancellationRefundPercent  Decimal?               @db.Decimal(5,2)

  selectedAmenityIds      String[]                  @default([])

  pricingBreakdown        Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  guestToken              String?                   @unique
  guestTokenExpiresAt     DateTime?
  verificationStatus                    String      @default("PENDING")
  verifiedAt                            DateTime?
  verificationCompletedByIp             String?
  verificationUserAgent                 String?
  verificationGuestCount                Int?
  verificationAcceptedRulesAt           DateTime?

  // Direct Booking Guest Identity Verification
  identityVerificationProvider           String?
  stripeIdentityVerificationSessionId    String?     @unique
  stripeIdentityVerificationStatus       String?
  stripeIdentityVerificationLastError    String?
  stripeIdentityVerificationLastEventAt  DateTime?
  stripeIdentityVerificationLastEventId  String?
  identityVerificationAttempts           Int         @default(0)
  identityVerificationConsentAt          DateTime?
  identityDeclaredLegalName              String?
  identityVerifiedLegalName              String?
  identityNameMatchStatus                String?

   // Direct Booking Protection fee snapshot
  directBookingProtectionFeeAmount       Decimal?    @db.Decimal(10, 2)
  identityVerificationRequiredSnapshot   Boolean?
  identityVerificationProviderCostAmount Decimal?    @db.Decimal(10, 2)
  guestAccessModeSnapshot                    GuestAccessMode @default(PASSCODE_ONLY)
  securePreCheckinDisclosureAcceptance       Json?
  guestAgreementSnapshot                     Json?
  guestAgreementAcceptance                   Json?
  guestAgreementSignedAt                     DateTime?
  guestAccessReleaseStatus     GuestAccessReleaseStatus @default(BLOCKED)
  guestAccessEligibleAt        DateTime?
  guestAccessReleasedAt        DateTime?
  guestAccessReleaseLastError  String?
  ingestKey                    String?                  @unique
  source                       String?
  externalId                   String?
  externalProvider             String?
  externalRaw                  Json?
  externalUpdatedAt            DateTime?
  lastIngestError              String?
  lastIngestedAt               DateTime?
  status                       ReservationStatus        @default(ACTIVE)
  lastHardwareSyncAt      DateTime?
  lastReconciledAt        DateTime?
  lastReconciledCheckIn   DateTime?
  lastReconciledCheckOut  DateTime?
  accessGrants            AccessGrant[]
  automationExecutionLogs AutomationExecutionLog[]
  guestLinkReminderLogs   GuestLinkReminderLog[]
  messageDispatchLogs     MessageDispatchLog[]
  NfcAssignment           NfcAssignment[]
  pmsLinks                PmsReservationLink[]
  guestJourney            GuestJourney?
  property                Property                    @relation(fields: [propertyId], references: [id])
  cancellationPolicy      PropertyCancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id],         onDelete: SetNull)
  staffAssignments        StaffAssignment[]

  @@unique([propertyId, externalProvider, externalId])
  @@index([propertyId, checkIn, checkOut])
  @@index([cancellationPolicyId])
  @@index([status, cancelledAt])
  @@index([propertyId, status, checkIn])
}

model GuestJourney {
  id            String            @id @default(cuid())
  reservationId String            @unique
  currentState  GuestJourneyState @default(RESERVATION_CONFIRMED)

  stateChangedAt DateTime @default(now())

  verificationCompletedAt DateTime?
  accessScheduledAt        DateTime?
  readyForArrivalAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  
  @@index([currentState])
  @@index([stateChangedAt])
}

model AccessCode {
  id               String       @id @default(cuid())
  lockId           Int
  accessGrantId    String?      @unique
  method           String
  keyboardPwdId    String?
  startDate        BigInt
  endDate          BigInt
  phone            String?
  createdAt        DateTime     @default(now())
  accessCodeEnc    String?
  accessCodeHash   String
  accessCodeMasked String
  expiresAt        DateTime

  accessGrant AccessGrant? @relation(fields: [accessGrantId], references: [id], onDelete: Cascade)

  @@index([lockId, createdAt])
  @@index([expiresAt])
  @@index([accessCodeHash])
}

model AccessGrant {
  id                         String           @id @default(cuid())
  lockId                     String
  personId                   String?
  reservationId              String?
  method                     AccessMethod
  status                     AccessStatus     @default(PENDING)
  startsAt                   DateTime
  endsAt                     DateTime
  unlockKey                  String?          @default("#")
  accessCodeMasked           String?
  ttlockKeyboardPwdId        Int?
  ttlockKeyId                Int?
  ttlockPayload              Json?
  linkedStripeEventId        String?
  linkedStripeCustomerId     String?
  linkedStripeSubscriptionId String?
  lastError                  String?
  
  recoveryOperation          String?
  recoveryAttemptCount       Int              @default(0)
  recoveryLastAttemptAt      DateTime?
  recoveryNextAttemptAt      DateTime?
  recoveryExhaustedAt        DateTime?
  
  createdAt                  DateTime         @default(now())
  updatedAt                  DateTime         @updatedAt
  staffMemberId              String?
  ttlockRefId                String?          @db.VarChar(128)
  type                       AccessGrantType  @default(GUEST)
  desiredEndsAt              DateTime?
  desiredStartsAt            DateTime?
  lastAppliedAt              DateTime?
  revokedReason              String?
  lock                       Lock             @relation(fields: [lockId], references: [id])
  person                     Person?          @relation(fields: [personId], references: [id])
  reservation                Reservation?     @relation(fields: [reservationId], references: [id])
  staffMember                StaffMember?     @relation(fields: [staffMemberId], references: [id])
  messages                   MessageLog[]
  secureAccessCode           AccessCode?
  staffAssignment            StaffAssignment?

  @@index([lockId, status, startsAt, endsAt])
  @@index([personId, status])
  @@index([reservationId, status])
  @@index([type, staffMemberId])
  @@index([reservationId, method, type])
  @@index([status, recoveryOperation, recoveryNextAttemptAt, recoveryExhaustedAt])
}

model StripeEventLog {
  id          String    @id @default(cuid())
  stripeId    String    @unique
  type        String
  livemode    Boolean?
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([type, processedAt])
}

model TTLockAuth {
  id             String       @id @default(cuid())
  organizationId String       @unique
  uid            Int?
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model LockGroup {
  id             String              @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  organization   Organization        @relation(fields: [organizationId], references: [id])
  locks          LockGroupLock[]
  assignments    ManagerAssignment[]

  @@index([organizationId])
}

model LockGroupLock {
  id          String    @id @default(cuid())
  lockGroupId String
  lockId      String
  lockGroup   LockGroup @relation(fields: [lockGroupId], references: [id])
  lock        Lock      @relation(fields: [lockId], references: [id])

  @@unique([lockGroupId, lockId])
}

model DeviceHealth {
  id                 String               @id @default(cuid())
  organizationId     String
  propertyId         String?
  lockId             String               @unique
  battery            Int?
  gatewayConnected   Boolean?
  isOnline           Boolean?
  lastSyncAt         DateTime?
  lastEventAt        DateTime?
  lastSeenAt         DateTime?
  healthStatus       DeviceHealthStatus   @default(UNKNOWN)
  healthMessage      String?
  source             String?
  rawPayload         Json?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  hasActiveAccess    Boolean?
  nextCheckInAt      DateTime?
  operationalMessage String?
  operationalRisk    OperationalRiskLevel @default(UNKNOWN)
  recommendedAction  String?
  riskCalculatedAt   DateTime?
  // Battery scheduling
  batteryLastCheckedAt DateTime?
  batteryNextCheckAt   DateTime?
  
  // Battery telemetry persistence
  batteryLastSuccessfulAt   DateTime?
  batteryLastFailedAt       DateTime?
  batteryLastError          String?
  batteryRawPayload         Json?
  batteryProviderResponseAt DateTime?
 
  // Gateway readiness scheduling
  gatewayLastCheckedAt       DateTime?
  gatewayLastSuccessfulAt    DateTime?
  gatewayNextCheckAt         DateTime?
  gatewayDisconnectedSince   DateTime?
  gatewayCheckReservationId  String?

  // Gateway telemetry persistence
  gatewayRssi               Int?
  gatewayLastFailedAt       DateTime?
  gatewayLastError          String?
  gatewayRawPayload         Json?
  gatewayProviderResponseAt DateTime?

  // Critical host alert lifecycle
  gatewayCriticalAlertReservationId String?
  gatewayCriticalAlertStatus        String?
  gatewayCriticalAlertAttemptCount  Int       @default(0)
  gatewayCriticalAlertLastAttemptAt DateTime?
  gatewayCriticalAlertSentAt        DateTime?
  gatewayCriticalAlertRecipients    Json?
  gatewayCriticalAlertLastError     String?
  lock               Lock                 @relation(fields: [lockId], references: [id], onDelete: Cascade)
  organization       Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property           Property?            @relation(fields: [propertyId], references: [id])

  @@index([organizationId])
  @@index([propertyId])
  @@index([healthStatus])
  @@index([operationalRisk])
  @@index([lastSeenAt])
  @@index([nextCheckInAt])
  @@index([batteryNextCheckAt])
  @@index([gatewayNextCheckAt])
  @@index([gatewayCheckReservationId])
  @@index([gatewayCriticalAlertReservationId, gatewayCriticalAlertStatus])
}

model ManagerAssignment {
  id          String    @id @default(cuid())
  personId    String
  lockGroupId String
  createdAt   DateTime  @default(now())
  lockGroup   LockGroup @relation(fields: [lockGroupId], references: [id])
  person      Person    @relation(fields: [personId], references: [id])

  @@unique([personId, lockGroupId])
}

model MessageLog {
  id                String       @id @default(cuid())
  channel           String
  to                String
  from              String?
  body              String
  provider          String
  providerMessageId String?
  status            String?
  accessGrantId     String?
  createdAt         DateTime     @default(now())
  error             String?
  retryCount        Int          @default(0)
  organizationId    String?
  propertyId        String?
  reservationId     String?
  accessGrant       AccessGrant? @relation(fields: [accessGrantId], references: [id])

  @@index([channel, to, createdAt])
  @@index([accessGrantId])
  @@index([reservationId])
  @@index([propertyId])
  @@index([organizationId])
  @@index([status, retryCount, createdAt])
  @@index([organizationId, propertyId, createdAt])
  @@index([organizationId, status, retryCount, createdAt])
}

model MessageDispatchLog {
  id            String      @id @default(cuid())
  reservationId String
  type          String
  channel       String
  status        String
  createdAt     DateTime    @default(now())
  reservation   Reservation @relation(fields: [reservationId], references: [id])

  @@index([reservationId, type])
}

model PrimeNotifyState {
  id             String   @id @default(cuid())
  organizationId String   @unique
  lastNotified   String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model StaffMember {
  id             String            @id @default(cuid())
  organizationId String
  fullName       String
  phoneE164      String?
  photoUrl       String?
  companyName    String?
  isActive       Boolean           @default(true)
  ttlockCardRef  String?           @db.VarChar(128)
  ttlockUserRef  String?           @db.VarChar(128)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  grants         AccessGrant[]
  assignments    StaffAssignment[]
  propertyStaff  PropertyStaff[]
  organization   Organization      @relation(fields: [organizationId], references: [id])

  @@index([organizationId, isActive])
  @@index([phoneE164])
}

model StaffAssignment {
  id            String                @id @default(cuid())
  reservationId String
  staffMemberId String
  method        StaffAccessMethod     @default(NFC_TIMEBOUND)
  startsAt      DateTime
  endsAt        DateTime
  status        StaffAssignmentStatus @default(SCHEDULED)
  lastError     String?
  retryCount    Int                   @default(0)
  accessGrantId String?               @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  accessGrant   AccessGrant?          @relation(fields: [accessGrantId], references: [id])
  reservation   Reservation           @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  staffMember   StaffMember           @relation(fields: [staffMemberId], references: [id])

  @@unique([reservationId, staffMemberId])
  @@index([reservationId])
  @@index([staffMemberId])
  @@index([status, startsAt, endsAt])
}

model PropertyStaff {
  id            String   @id @default(cuid())
  propertyId    String
  staffMemberId String

  role          PropertyStaffRole
  backupOrder   Int? // solo para BACKUP

  isActive      Boolean @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  property      Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  staffMember   StaffMember  @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)

  @@unique([propertyId, staffMemberId])
  @@index([propertyId])
  @@index([staffMemberId])
}

model CleaningConfirmation {
  id             String   @id @default(cuid())
  reservationId  String
  propertyId     String
  staffMemberId  String

  token          String   @unique
  status         String   // PENDING | CONFIRMED | DECLINED

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model GuestLinkReminderLog {
  id            String       @id @default(cuid())
  reservationId String
  channel       String       @default("sms")
  createdAt     DateTime     @default(now())
  error         String?
