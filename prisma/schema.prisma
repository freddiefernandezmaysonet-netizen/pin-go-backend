generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String          @id @default(cuid())
  name             String
  createdAt        DateTime        @default(now())
  slug             String?         @unique
  publicBookingEnabled Boolean     @default(false)
  updatedAt        DateTime        @updatedAt
  stripeCustomerId String?

  // Stripe Connect / Host Payouts V1
  stripeConnectAccountId        String?              @unique
  stripeConnectStatus           StripeConnectStatus  @default(NOT_CONNECTED)
  stripeConnectChargesEnabled   Boolean              @default(false)
  stripeConnectPayoutsEnabled   Boolean              @default(false)
  stripeConnectDetailsSubmitted Boolean              @default(false)
  stripeConnectRequirements     Json?
  stripeConnectDisabledReason   String?
  stripeConnectLastSyncedAt     DateTime?

  dashboardUsers   DashboardUser[]
  deviceHealths    DeviceHealth[]
  lockGroups       LockGroup[]
  pendingSignups   PendingSignup[]
  people           Person[]
  pmsConnections   PmsConnection[]
  properties       Property[]
  staffMembers     StaffMember[]
  subscriptions    Subscription?
  ttlockAuth       TTLockAuth?
  brandProfile            BrandProfile?
  organizationInvitations OrganizationInvitation[]
  propertyReviews               PropertyReview[]
  propertyReviewInvitations     PropertyReviewInvitation[]
  propertyReviewModerationCases PropertyReviewModerationCase[]
}

model DashboardUser {
  id                  String               @id @default(cuid())
  organizationId      String
  email               String               @unique
  passwordHash        String
  fullName            String?
  role                DashboardUserRole    @default(ORG_ADMIN)
  isActive            Boolean              @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tokenVersion        Int                  @default(0)
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  passwordResetTokens PasswordResetToken[]
  passwordResetSmsCodes PasswordResetSmsCode[]
  brandRevisionsCreated           BrandRevision[]          @relation("BrandRevisionCreatedBy")
  brandRevisionsApproved          BrandRevision[]          @relation("BrandRevisionApprovedBy")
  brandRevisionsRejected          BrandRevision[]          @relation("BrandRevisionRejectedBy")
  brandDomainsCreated             BrandDomain[]            @relation("BrandDomainCreatedBy")
  organizationInvitationsCreated  OrganizationInvitation[] @relation("OrganizationInvitationCreatedBy")
  organizationInvitationsAccepted OrganizationInvitation[] @relation("OrganizationInvitationAcceptedBy")
  propertyReviewResponses         PropertyReviewResponse[]         @relation("PropertyReviewResponseAuthor")
  propertyReviewResponseRevisions PropertyReviewResponseRevision[] @relation("PropertyReviewResponseRevisionAuthor")
  propertyReviewModerationEvents  PropertyReviewModerationEvent[]  @relation("PropertyReviewModerationActor")

  @@index([organizationId, isActive])
  @@index([organizationId, role])
}

model PasswordResetToken {
  id        String        @id @default(cuid())
  userId    String
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetSmsCode {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user DashboardUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([phone])
  @@index([expiresAt])
}

model BrandProfile {
  id               String              @id @default(cuid())
  organizationId   String              @unique
  experienceType   BrandExperienceType @default(STANDARD)
  status           BrandProfileStatus  @default(DRAFT)
  activeRevisionId String?             @unique
  activeDomainId   String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeRevision BrandRevision?  @relation("BrandProfileActiveRevision", fields: [activeRevisionId], references: [id], onDelete: SetNull)
  activeDomain   BrandDomain?    @relation("BrandProfileActiveDomain", fields: [activeDomainId], references: [id], onDelete: SetNull)
  revisions      BrandRevision[] @relation("BrandProfileRevisions")
  domains        BrandDomain[]   @relation("BrandProfileDomains")

  @@index([experienceType, status])
}

model BrandRevision {
  id               String                      @id @default(cuid())
  brandProfileId   String
  version          Int
  displayName      String
  logoUrl          String
  logoPublicId     String
  faviconUrl       String
  faviconPublicId  String
  primaryColor     String                      @db.VarChar(7)
  approvalStatus   BrandRevisionApprovalStatus @default(DRAFT)
  createdByUserId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  rejectedByUserId String?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  brandProfile     BrandProfile   @relation("BrandProfileRevisions", fields: [brandProfileId], references: [id], onDelete: Cascade)
  activeForProfile BrandProfile?  @relation("BrandProfileActiveRevision")
  createdBy        DashboardUser? @relation("BrandRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy       DashboardUser? @relation("BrandRevisionApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  rejectedBy       DashboardUser? @relation("BrandRevisionRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)

  @@unique([brandProfileId, version])
  @@index([brandProfileId, approvalStatus])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([rejectedByUserId])
}

model BrandDomain {
  id               String              @id @default(cuid())
  brandProfileId   String
  hostname         String              @unique @db.VarChar(253)
  type             BrandDomainType
  status           BrandDomainStatus   @default(PENDING_CONFIGURATION)
  provider         BrandDomainProvider @default(VERCEL)
  providerDomainId String?             @unique
  verifiedAt       DateTime?
  activatedAt      DateTime?
  retiredAt        DateTime?
  redirectUntil    DateTime?
  createdByUserId  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  brandProfile     BrandProfile   @relation("BrandProfileDomains", fields: [brandProfileId], references: [id], onDelete: Cascade)
  activeForProfile BrandProfile?  @relation("BrandProfileActiveDomain")
  createdBy        DashboardUser? @relation("BrandDomainCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([brandProfileId, status])
  @@index([createdByUserId])
  @@index([status, redirectUntil])
}

model OrganizationInvitation {
  id              String            @id @default(cuid())
  organizationId  String
  email           String            @db.VarChar(320)
  role            DashboardUserRole @default(ORG_ADMIN)
  tokenHash       String            @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  createdByUserId String?
  acceptedUserId  String?
  createdAt       DateTime          @default(now())

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    DashboardUser? @relation("OrganizationInvitationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  acceptedUser DashboardUser? @relation("OrganizationInvitationAcceptedBy", fields: [acceptedUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@index([createdByUserId])
  @@index([acceptedUserId])
}

model Property {
  id                         String                      @id @default(cuid())
  organizationId             String
  name                       String
  slug                       String?
  isPublicBookable           Boolean                     @default(false)
  distributionEnabled        Boolean                     @default(false)
  distributionStatus         String                      @default("DISABLED")
  distributionEnabledAt      DateTime?
  distributionLastSyncedAt   DateTime?
  distributionLastError      String?
  publicTitle                String?
  publicDescription          String?
  publicDescriptionEs        String?
  publicPhotos               Json?
  baseNightlyRate            Decimal?                    @db.Decimal(10,2)
  minimumNightlyRate         Decimal?                    @db.Decimal(10,2)
  maximumNightlyRate         Decimal?                    @db.Decimal(10,2)
  dynamicPricingEnabled      Boolean                     @default(false)
  weekendMarkupPercent       Decimal?                    @db.Decimal(5,2)
  leadTimePricingEnabled     Boolean                     @default(false)
  leadTimeLastMinuteDays     Int                         @default(3)
  leadTimeLastMinutePercent  Decimal?                    @db.Decimal(5,2)
  occupancyPricingEnabled    Boolean                     @default(false)
  occupancyLookaheadDays     Int                         @default(30)
  occupancyLowThresholdPercent   Decimal?                @db.Decimal(5,2)
  occupancyLowAdjustmentPercent  Decimal?                @db.Decimal(5,2)
  occupancyHighThresholdPercent  Decimal?                @db.Decimal(5,2)
  occupancyHighAdjustmentPercent Decimal?                @db.Decimal(5,2)
  seasonalPricingEnabled     Boolean                     @default(false)
  holidayPricingEnabled      Boolean                     @default(false)
  eventPricingEnabled        Boolean                     @default(false)
  autonomousPricingEnabled   Boolean                     @default(false)
  cleaningFee                Decimal?                    @db.Decimal(10,2)
  maxGuests                  Int?
  minimumNights              Int                         @default(1)
  maximumNights              Int?
  address1                   String?
  city                       String?
  region                     String?
  country                    String?
  timezone                   String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  cleaningDurationMinutes    Int                         @default(180)
  cleaningStartOffsetMinutes Int                         @default(30)
  status                     String                      @default("ACTIVE")
  latitude                   Decimal?                    @db.Decimal(10, 7)
  longitude                  Decimal?                    @db.Decimal(10, 7)
  smartAutomationEnabled     Boolean                     @default(false)
  checkInTime                String?                     @db.VarChar(5)
  checkOutTime               String?                     @db.VarChar(5)
  automationExecutionLogs    AutomationExecutionLog[]
  automationRules            AutomationRule[]
  deviceHealths              DeviceHealth[]
  locks                      Lock[]
  organization               Organization                @relation(fields: [organizationId], references: [id])
  guestAccessMode            GuestAccessMode             @default(PASSCODE_ONLY)
  cleaningNfcEnabled         Boolean                     @default(false)
  automationDevices          PropertyAutomationDevice[]
  automationSettings         PropertyAutomationSettings?
  propertyDevices            PropertyDevice[]
  propertyStaff              PropertyStaff[]
  amenities                  PropertyAmenity[]
  taxes                      PropertyTax[]
  nightlyRates               PropertyNightlyRate[]
  seasons                    PropertySeason[]
  holidayPricings            PropertyHolidayPricing[]
  reservations               Reservation[]
  blockedDates               PropertyBlockedDate[]
  cancellationPolicies       PropertyCancellationPolicy[]
  guestAgreements            PropertyGuestAgreement[]
  reviews                    PropertyReview[]
  reviewInvitations          PropertyReviewInvitation[]
  reviewModerationCases      PropertyReviewModerationCase[]


  @@index([organizationId])
  @@index([organizationId, status])
  @@unique([organizationId, slug])
}

model PropertyNightlyRate {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])

  date       DateTime
  rate       Decimal  @db.Decimal(10, 2)
  reason     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([propertyId, date])
  @@index([propertyId, date])
}

model PropertySeason {
  id                String   @id @default(cuid())
  propertyId        String
  name              String
  type              SeasonType @default(SHOULDER)
  startMonth        Int
  startDay          Int
  endMonth          Int
  endDay            Int
  adjustmentPercent Decimal  @db.Decimal(5,2)
  isActive          Boolean  @default(true)
  source            String   @default("CUSTOM")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, isActive])
  @@index([propertyId, source])
  @@index([type])

}

model MarketSeasonTemplate {
  id                String   @id @default(cuid())
  country           String
  region            String?
  name              String
  type              SeasonType @default(SHOULDER)
  startMonth        Int
  startDay          Int
  endMonth          Int
  endDay            Int
  adjustmentPercent Decimal  @db.Decimal(5,2)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([country])
  @@index([country, isActive])
  @@index([country, region])
  @@index([type])
}

model PropertyHolidayPricing {
  id                String   @id @default(cuid())
  propertyId        String
  name              String
  startMonth        Int
  startDay          Int
  endMonth          Int
  endDay            Int
  adjustmentPercent Decimal  @db.Decimal(5,2)
  isActive          Boolean  @default(true)
  source            String   @default("PIN_GO_DEFAULT")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, isActive])
  @@index([propertyId, source])
}

model Lock {
  id             String          @id @default(cuid())
  ttlockLockId   Int             @unique
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  isActive       Boolean         @default(true)
  locationLabel  String?
  propertyId     String
  ttlockLockName String?
  displayName    String?
  sGrants        AccessGrant[]
  deviceHealth   DeviceHealth?
  property       Property        @relation(fields: [propertyId], references: [id])
  groups         LockGroupLock[]

  @@index([propertyId, isActive])
}

model Person {
  id               String              @id @default(cuid())
  organizationId   String
  role             PersonRole
  fullName         String
  email            String?
  phone            String?
  stripeCustomerId String?             @unique
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  accessGrants     AccessGrant[]
  assignments      ManagerAssignment[]
  organization     Organization        @relation(fields: [organizationId], references: [id])
  subscriptions    Subscription[]

  @@index([organizationId, role])
}

model PendingSignup {
  id                      String              @id @default(cuid())
  email                   String
  passwordHash            String
  fullName                String?
  organizationName        String
  phone                   String?
  requestedLocks          Int                 @default(1)
  stripeCheckoutSessionId String?             @unique
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  stripePriceId           String?
  status                  PendingSignupStatus @default(PENDING)
  organizationId          String?
  completedAt             DateTime?
  expiresAt               DateTime?
  metadata                Json?
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  organization            Organization?       @relation(fields: [organizationId], references: [id])

  @@index([email])
  @@index([status])
  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Subscription {
  id                            String             @id @default(cuid())
  personId                      String?
  stripeSubscriptionId          String?            @unique
  status                        SubscriptionStatus
  currentPeriodStart            DateTime?
  currentPeriodEnd              DateTime?
  createdAt                     DateTime           @default(now())
  updatedAt                     DateTime           @updatedAt
  graceUntil                    DateTime?
  organizationId                String             @unique
  stripeCustomerId              String?
  entitledLocks                 Int                @default(0)
  stripeSubscriptionItemId      String?
  entitledSmartProperties       Int                @default(0)
  stripeSmartSubscriptionItemId String?
  organization                  Organization       @relation(fields: [organizationId], references: [id])
  person                        Person?            @relation(fields: [personId], references: [id])

  @@index([personId, status])
  @@index([organizationId, status])
}

model Reservation {
  id                      String                   @id @default(cuid())
  reservationNumber       String?                  @unique
  propertyId              String
  guestName               String
  guestEmail              String?
  guestPhone              String?
  preferredLanguage       String                   @default("en")
  roomName                String?
  checkIn                 DateTime
  checkOut                DateTime
  paymentState            PaymentState             @default(NONE)
  totalAmount             Decimal?                 @db.Decimal(10,2)
  amountCollected         Decimal                  @default(0) @db.Decimal(10,2)
  amountRefunded          Decimal                  @default(0) @db.Decimal(10,2)
  currency                String?                  @default("usd")
  stripeCheckoutSessionId String?                  @unique
  stripePaymentIntentId   String?
  // Stripe Connect / Host Payouts V1
  stripeConnectedAccountId String?
  stripeChargeId           String?
  stripeTransferId         String?
  stripeApplicationFeeId   String?
  basePlatformFeeAmount    Decimal?                @db.Decimal(10,2)
  platformFeeAmount        Decimal?                @db.Decimal(10,2)
  hostPayoutAmount         Decimal?                @db.Decimal(10,2)
  hostPayoutStatus         HostPayoutStatus        @default(NOT_APPLICABLE)
  hostPayoutFailureReason  String?
  hostPayoutLastSyncedAt   DateTime?

  // Direct Booking Cancellation Policy Engine V1
  cancellationPolicyId       String?
  cancellationPolicySnapshot Json?
  cancellationRequestedAt    DateTime?
  cancellationRequestedBy    CancellationActor?
  cancellationEvaluatedAt    DateTime?
  cancellationEvaluation     Json?
  cancelledAt                DateTime?
  cancelledBy                CancellationActor?
  cancelledByUserId          String?
  cancellationReason         String?
  cancellationRefundAmount   Decimal?               @db.Decimal(10,2)
  cancellationRefundPercent  Decimal?               @db.Decimal(5,2)

  selectedAmenityIds      String[]                  @default([])
  adults                  Int                       @default(1)
  children                Int                       @default(0)

  pricingBreakdown        Json?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  guestToken              String?                   @unique
  guestTokenExpiresAt     DateTime?
  verificationStatus                    String      @default("PENDING")
  verifiedAt                            DateTime?
  verificationCompletedByIp             String?
  verificationUserAgent                 String?
  verificationGuestCount                Int?
  verificationAcceptedRulesAt           DateTime?

  // Direct Booking Guest Identity Verification
  identityVerificationProvider           String?
  stripeIdentityVerificationSessionId    String?     @unique
  stripeIdentityVerificationStatus       String?
  stripeIdentityVerificationLastError    String?
  stripeIdentityVerificationLastEventAt  DateTime?
  stripeIdentityVerificationLastEventId  String?
  identityVerificationAttempts           Int         @default(0)
  identityVerificationConsentAt          DateTime?
  identityDeclaredLegalName              String?
  identityVerifiedLegalName              String?
  identityNameMatchStatus                String?

   // Direct Booking Protection fee snapshot
  directBookingProtectionFeeAmount       Decimal?    @db.Decimal(10, 2)
  identityVerificationRequiredSnapshot   Boolean?
  identityVerificationProviderCostAmount Decimal?    @db.Decimal(10, 2)
  guestAccessModeSnapshot                    GuestAccessMode @default(PASSCODE_ONLY)
  securePreCheckinDisclosureAcceptance       Json?
  guestAgreementSnapshot                     Json?
  guestAgreementAcceptance                   Json?
  guestAgreementSignedAt                     DateTime?
  guestAccessReleaseStatus     GuestAccessReleaseStatus @default(BLOCKED)
  guestAccessEligibleAt        DateTime?
  guestAccessReleasedAt        DateTime?
  guestAccessReleaseLastError  String?
  ingestKey                    String?                  @unique
  source                       String?
  externalId                   String?
  externalProvider             String?
  externalRaw                  Json?
  externalUpdatedAt            DateTime?
  lastIngestError              String?
  lastIngestedAt               DateTime?
  status                       ReservationStatus        @default(ACTIVE)
  lastHardwareSyncAt      DateTime?
  lastReconciledAt        DateTime?
  lastReconciledCheckIn   DateTime?
  lastReconciledCheckOut  DateTime?
  accessGrants            AccessGrant[]
  automationExecutionLogs AutomationExecutionLog[]
  guestLinkReminderLogs   GuestLinkReminderLog[]
  messageDispatchLogs     MessageDispatchLog[]
  NfcAssignment           NfcAssignment[]
  pmsLinks                PmsReservationLink[]
  guestJourney            GuestJourney?
  guestJourneyCoordinationIntents GuestJourneyCoordinationIntent[]
  property                Property                    @relation(fields: [propertyId], references: [id])
  cancellationPolicy      PropertyCancellationPolicy? @relation(fields: [cancellationPolicyId], references: [id],         onDelete: SetNull)
  staffAssignments        StaffAssignment[]
  modifications           ReservationModification[]
  review                   PropertyReview?
  reviewInvitation         PropertyReviewInvitation?

  @@unique([propertyId, externalProvider, externalId])
  @@index([propertyId, checkIn, checkOut])
  @@index([cancellationPolicyId])
  @@index([status, cancelledAt])
  @@index([propertyId, status, checkIn])
}

model PropertyReview {
  id                      String               @id @default(cuid())
  organizationId          String
  propertyId              String
  reservationId           String               @unique
  source                  PropertyReviewSource @default(PIN_GO_DIRECT)
  status                  PropertyReviewStatus @default(PENDING_MODERATION)
  overallRating           Int
  cleanlinessRating       Int
  accuracyRating          Int
  checkInAccessRating     Int
  communicationRating     Int
  locationRating          Int
  valueRating             Int
  publicComment           String               @db.Text
  privateFeedback         String?              @db.Text
  language                String               @default("en") @db.VarChar(10)
  guestDisplayName        String               @db.VarChar(80)
  stayMonth               DateTime
  submittedAt             DateTime             @default(now())
  publishedAt             DateTime?
  firstPublishedAt        DateTime?
  removedAt               DateTime?
  moderationVersion       Int                  @default(0)
  moderationPolicyVersion String               @default("reviews_e1_v1") @db.VarChar(40)
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt

  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property        Property                       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation     Reservation                    @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  response        PropertyReviewResponse?
  moderationCases PropertyReviewModerationCase[]

  @@index([organizationId, status, submittedAt])
  @@index([propertyId, status, publishedAt])
  @@index([status, submittedAt])
}

model PropertyReviewInvitation {
  id                        String                                  @id @default(cuid())
  organizationId            String
  propertyId                String
  reservationId             String                                  @unique
  tokenHash                 String                                  @unique @db.VarChar(64)
  recipientEmailHash        String                                  @db.VarChar(64)
  status                    PropertyReviewInvitationStatus          @default(ELIGIBLE)
  expiresAt                 DateTime
  invitedAt                 DateTime?
  consumedAt                DateTime?
  tokenCiphertext           String                                  @db.Text
  deliveryStatus            PropertyReviewInvitationDeliveryStatus @default(PENDING)
  deliveryAttemptCount      Int                                     @default(0)
  lastDeliveryAttemptAt     DateTime?
  providerAcceptedAt        DateTime?
  deliveryProviderMessageId String?
  lastDeliveryError         String?                                 @db.Text
  deliveryLeaseOwner        String?                                 @db.VarChar(120)
  deliveryLeaseExpiresAt    DateTime?
  createdAt                 DateTime                                @default(now())
  updatedAt                 DateTime                                @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  property     Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservation  Reservation  @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@index([propertyId, status])
  @@index([deliveryStatus, deliveryLeaseExpiresAt, expiresAt], map: "PropertyReviewInvitation_delivery_queue_idx")
  @@index([status, expiresAt])
}

model PropertyReviewResponse {
  id           String                       @id @default(cuid())
  reviewId     String                       @unique
  authorUserId String
  body         String                       @db.Text
  status       PropertyReviewResponseStatus @default(PUBLISHED)
  publishedAt  DateTime?
  createdAt    DateTime                     @default(now())
  updatedAt    DateTime                     @updatedAt
  revision     Int                          @default(1)

  review    PropertyReview                   @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  author    DashboardUser                    @relation("PropertyReviewResponseAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  revisions PropertyReviewResponseRevision[]

  @@index([authorUserId])
}

model PropertyReviewResponseRevision {
  id           String                             @id @default(cuid())
  responseId   String
  revision     Int
  authorUserId String
  body         String                             @db.Text
  status       PropertyReviewResponseStatus
  kind         PropertyReviewResponseRevisionKind @default(HOST_WRITE)
  reasonCode   PropertyReviewModerationReason?
  note         String?                            @db.Text
  createdAt    DateTime                           @default(now())

  response PropertyReviewResponse @relation(fields: [responseId], references: [id], onDelete: Restrict)
  author   DashboardUser          @relation("PropertyReviewResponseRevisionAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([responseId, revision])
  @@index([authorUserId, createdAt])
}

model PropertyReviewModerationCase {
  id             String                             @id @default(cuid())
  organizationId String
  propertyId     String
  reviewId       String
  status         PropertyReviewModerationCaseStatus @default(OPEN)
  reasonCode     PropertyReviewModerationReason
  evidence       Json?
  openedAt       DateTime                           @default(now())
  resolvedAt     DateTime?
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt

  organization Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property     Property                        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  review       PropertyReview                  @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  events       PropertyReviewModerationEvent[]

  @@index([organizationId, status, openedAt])
  @@index([reviewId, status])
  @@index([status, openedAt])
}

model PropertyReviewModerationEvent {
  id            String                         @id @default(cuid())
  caseId        String
  actorUserId   String?
  action        PropertyReviewModerationAction
  reasonCode    PropertyReviewModerationReason?
  evidence      Json?
  note          String?                        @db.Text
  policyVersion String                         @default("reviews_e1_v1") @db.VarChar(40)
  createdAt     DateTime                       @default(now())

  moderationCase PropertyReviewModerationCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
