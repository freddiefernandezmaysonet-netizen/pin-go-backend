}

model PropertyCancellationPolicy {
  id         String   @id @default(cuid())
  propertyId String

  name        String
  type        CancellationPolicyType @default(FLEXIBLE)
  source      String                 @default("CUSTOM")
  isActive    Boolean                @default(true)

  // Main automation rule
  guestSelfCancellationEnabled      Boolean @default(true)
  autoRefundEligibleCancellations   Boolean @default(true)
  requireHostApprovalOutsidePolicy  Boolean @default(true)

  // Deadline + refund calculation
  freeCancellationHoursBeforeCheckIn Int     @default(168)
  refundBasis                         CancellationRefundBasis @default(TOTAL_AMOUNT)
  refundPercentBeforeDeadline         Decimal @default(100.00) @db.Decimal(5,2)
  refundPercentAfterDeadline          Decimal @default(0.00)   @db.Decimal(5,2)

  // Fee behavior
  cleaningFeeRefundable  Boolean @default(true)
  amenitiesRefundable    Boolean @default(true)
  taxesRefundable        Boolean @default(true)

  // Future rate strategy
  nonRefundableDiscountPercent Decimal? @db.Decimal(5,2)

  // Cancellation Policy Engine V1.1
  // Supports tiered market policies like:
  // 30+ days before check-in = 100% refund
  // 14-30 days before check-in = 50% refund
  // <14 days before check-in = 0% refund
  refundRules Json?
  nonRefundableScenarios Json?
  guestFacingSummary String?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  property     Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  reservations Reservation[]

  @@index([propertyId])
  @@index([propertyId, isActive])
  @@index([type])
}

