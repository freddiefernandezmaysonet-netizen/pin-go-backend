  @@index([propertyId])
}

model PropertyBlockedDate {
  id         String   @id @default(cuid())

  propertyId String

  startDate  DateTime
  endDate    DateTime

  reason     String?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
