// One payable service record per canonical reservation. Invoice fields are
// retained for historical evidence only; new fees use Connect Account Debits.
model PinAIReservationFee {
  reservationId String @id
  organizationId String
  propertyId String
  amountCents Int @default(100)
  currency String @default("USD")
  termsVersion String
  acceptedBy String
  acceptedAt DateTime
  serviceStartedAt DateTime
  recordedAt DateTime @default(now())
  billingStatus String @default("PENDING_CONNECT")
  stripeConnectedAccountId String?
  stripeDebitPaymentId String? @unique
  debitStartedAt DateTime?
  debitGeneration Int @default(0)
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripeInvoiceItemId String? @unique
  stripeInvoiceId String?
  exportStartedAt DateTime?
  exportLeaseToken String?
  exportLeaseUntil DateTime?
  exportNextAttemptAt DateTime?
  exportAttempts Int @default(0)
  lastError String?
  paidAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([organizationId, billingStatus, recordedAt])
  @@index([billingStatus, exportNextAttemptAt])
}

// Eligibility evidence saved before the window opens. This is not a fee.
model PinAIServiceEnrollment {
  reservationId String @id
  organizationId String
  propertyId String
  stripeConnectedAccountId String
  termsVersion String
  acceptedBy String
  acceptedAt DateTime
  enrolledAt DateTime
  checkIn DateTime
  checkOut DateTime
  opensAt DateTime
  closesAt DateTime
  propertyRevision Int
  organizationRevision Int
  status String @default("SCHEDULED")
  reason String?
  resolvedAt DateTime?
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, opensAt])
}
