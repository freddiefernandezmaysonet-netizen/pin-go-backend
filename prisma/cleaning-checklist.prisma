model CleaningChecklistTemplate {
  propertyId String @id
  revision Int @default(1)
  items Json
  updatedByUserId String
  updatedAt DateTime @updatedAt
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
}

// One stable checklist per departure cleaning, independent of offer/cleaner.
model CleaningTaskChecklist {
  id String @id @default(cuid())
  reservationId String @unique
  propertyId String
  templateRevision Int
  legacy Boolean @default(false)
  createdAt DateTime @default(now())
  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  items CleaningTaskChecklistItem[]
  @@index([propertyId])
}

model CleaningTaskChecklistItem {
  id String @id @default(cuid())
  checklistId String
  templateKey String
  position Int
  labelEs String @db.VarChar(500)
  labelEn String @db.VarChar(500)
  required Boolean
  checked Boolean @default(false)
  checkedAt DateTime?
  checkedByStaffMemberId String?
  version Int @default(0)
  checklist CleaningTaskChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  events CleaningChecklistItemEvent[]
  @@unique([checklistId, templateKey])
  @@index([checklistId, position])
}

// Actor identity/name are retained as audit snapshots when Staff is removed.
model CleaningChecklistItemEvent {
  id String @id @default(cuid())
  checklistItemId String
  actorStaffMemberId String
  actorName String
  checked Boolean
  createdAt DateTime @default(now())
  item CleaningTaskChecklistItem @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  @@index([checklistItemId, createdAt])
}
